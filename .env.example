# Database Configuration
DATABASE_URL=postgresql://postgres:root@localhost:5432/job_ingestion

# Source Request Pacing & Limits
PYTHON_ORG_REQUESTS_PER_MINUTE=20
PYTHON_ORG_MIN_REQUEST_INTERVAL=1.5
PYTHON_ORG_MAX_PAGES=3

MUSE_REQUESTS_PER_MINUTE=30
MUSE_MIN_REQUEST_INTERVAL=1.0
MUSE_MAX_PAGES=3

# Resilience & Retry Policy
REQUEST_TIMEOUT_SECONDS=12.0
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2.0

# Scheduler
INGESTION_INTERVAL_MINUTES=5
